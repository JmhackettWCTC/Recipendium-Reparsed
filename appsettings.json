{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SassCompiler": {
    "Source": "wwwroot/css",
    "TargetFolder": "wwwroot/css",
    "Style": "Compressed",
    "SourceMap": false,
    "MimeType": "text/css",
    "Watch": false
  }
}
