<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Recipendium</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header>
    <div class="site-width">
        <div class="static-row" id="desktop">
            <div class="flex-1">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="site-title">Recipendium</a>
            </div>
            <nav class="flex-1 right">
                <ul>
                    <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-area="" asp-controller="Recipe" asp-action="Index">Recipes</a></li>
                    <li class="nav-dropdown">
                        <button type="button" class="dropdown-toggle" aria-expanded="false">Add ▾</button>
                        <ul class="dropdown-menu">
                            <li><a asp-area="" asp-controller="Recipe" asp-action="Create">Add Recipe</a></li>
                            <li><a asp-area="" asp-controller="Category" asp-action="Create">Add Category</a></li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>

<article class="site-width">
    <main role="main">
        @RenderBody()
    </main>
</article>

<footer>
    <p>&copy; 2026 - Recipendium</p>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
