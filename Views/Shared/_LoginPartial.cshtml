@* Login Partial - Shows authentication state in the navbar *@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<Recipendium_Reparsed.Models.ApplicationUser> SignInManager
@inject UserManager<Recipendium_Reparsed.Models.ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrEmpty(user?.DisplayName) ? user.DisplayName : user?.Email;

    <span class="nav-user">Hello, @displayName!</span>
    <form asp-action="Logout" asp-controller="Account" method="post" class="nav-signout-form">
        <button type="submit" class="btn-signout">Sign out</button>
    </form>
}
else
{
    <a asp-action="Login" asp-controller="Account" class="nav-login-link">Login</a>
}
