@* Category Index - Displays all categories *@
@model List<Recipendium_Reparsed.Models.Category>

@{
    ViewData["Title"] = "Categories";
    var categoriesJson = System.Text.Json.JsonSerializer.Serialize(Model.Select(c => new {
        id = c.Id,
        name = c.Name,
        description = c.Description,
        recipeCount = c.Recipes.Count
    }));
}

<div id="app">
    <category-index :categories-json='@Html.Raw(categoriesJson)'></category-index>
</div>

@section Scripts {
    <script type="module">
        import CategoryIndex from '/js/components/CategoryIndexComponent.js';
        import { mountApp } from '/js/main.js';
        mountApp('#app', { 'category-index': CategoryIndex });
    </script>
}
