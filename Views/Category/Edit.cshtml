@* Edit Category Form *@
@model Recipendium_Reparsed.Models.Category

@{
    ViewData["Title"] = "Edit Category";
    var categoryJson = System.Text.Json.JsonSerializer.Serialize(new {
        id = Model.Id,
        name = Model.Name,
        description = Model.Description,
        slug = Model.Slug,
        image = Model.Image
    });
}

<form asp-action="Edit">
    <div id="app">
        <category-form
            :category-json='@Html.Raw(categoryJson)'
            is-create="false"
            submit-label="Save Changes"
            submit-icon="save"
        ></category-form>
    </div>
</form>

@section Scripts {
    <script type="module">
        import CategoryForm from '/js/components/CategoryFormComponent.js';
        import { mountApp } from '/js/main.js';
        mountApp('#app', { 'category-form': CategoryForm });
    </script>
}
