@* Create Category Form *@
@model Recipendium_Reparsed.Models.Category

@{
    ViewData["Title"] = "Create Category";
    var recipes = ViewData["Recipes"] as List<Recipendium_Reparsed.Models.Recipe> ?? new List<Recipendium_Reparsed.Models.Recipe>();
    var recipesJson = System.Text.Json.JsonSerializer.Serialize(recipes.Select(r => new { id = r.Id, name = r.Name }));
}

<form asp-action="Create">
    <div id="app">
        <category-form
            :recipes-json='@Html.Raw(recipesJson)'
            is-create="true"
            submit-label="Create Category"
            submit-icon="add_circle"
        ></category-form>
    </div>
</form>

@section Scripts {
    <script type="module">
        import CategoryForm from '/js/components/CategoryFormComponent.js';
        import { mountApp } from '/js/main.js';
        mountApp('#app', { 'category-form': CategoryForm });
    </script>
}
