@{
    ViewData["Title"] = "Home Page";
    var featuredRecipes = ViewData["FeaturedRecipes"] ?? "[]";
}

<div id="app">
    <home-page featured-recipes="@featuredRecipes"></home-page>
</div>

@section Scripts {
    <script type="module">
        import HomePage from '/js/components/HomeComponent.js';
        import { mountApp } from '/js/main.js';
        mountApp('#app', { 'home-page': HomePage });
    </script>
    <script src="https://jgrissom.github.io/dotnet-web-dev/week-11/homework-checks.js"></script>
}
