@* Edit Recipe Form - Allows users to modify an existing recipe *@
@model Recipendium_Reparsed.Models.Recipe

@{
    ViewData["Title"] = "Edit Recipe";
    var categories = ViewData["Categories"] as List<Recipendium_Reparsed.Models.Category> ?? new List<Recipendium_Reparsed.Models.Category>();
    var categoriesJson = System.Text.Json.JsonSerializer.Serialize(categories.Select(c => new { id = c.Id, name = c.Name }));
    var recipeJson = System.Text.Json.JsonSerializer.Serialize(new {
        id = Model.Id,
        name = Model.Name,
        categoryId = Model.CategoryId,
        time = Model.Time,
        servings = Model.Servings,
        ingredients = Model.Ingredients,
        instructions = Model.Instructions,
        shortDescription = Model.ShortDescription,
        longDescription = Model.LongDescription,
        rating = Model.Rating
    });
}

<form asp-action="Edit" enctype="multipart/form-data">
    <div id="app">
        <recipe-form
            :recipe-json='@Html.Raw(recipeJson)'
            :categories-json='@Html.Raw(categoriesJson)'
            is-create="false"
            submit-label="Save Changes"
            submit-icon="save"
        ></recipe-form>
    </div>
</form>

@section Scripts {
    <script type="module">
        import RecipeForm from '/js/components/RecipeFormComponent.js';
        import { mountApp } from '/js/main.js';
        mountApp('#app', { 'recipe-form': RecipeForm });
    </script>
}
