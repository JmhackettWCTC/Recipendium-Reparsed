@model Recipe

@{
    ViewData["Title"] = "Delete Recipe";
}

<header>
    <h1>Delete Recipe</h1>
</header>

<section>
    <h3>Are you sure you want to delete this?</h3>
</section>

<div class="recipe-list">
    <h4>@Model.Name</h4>
    <p><strong>Category:</strong> @Model.Category</p>
    <p><strong>Time:</strong> @Model.Time mins</p>
    <p><strong>Servings:</strong> @Model.Servings</p>
    <p><strong>Description:</strong> @Model.ShortDescription</p>
    <p><strong>Rating:</strong> @Model.Rating / 5</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="menacingBtn">Delete</button>
</form>

<a class="back-btn" asp-action="Index">← Back to Recipes</a>
