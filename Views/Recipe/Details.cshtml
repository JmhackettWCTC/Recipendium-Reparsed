@model Recipe
@{
    ViewData["Title"] = Model.Name;
    String[] ingredients = Model.Ingredients.Split(",");
    String[] instructions = Model.Instructions.Split("|");
}

<article>
    <header>
        <h2>@Model.Name</h2>
        <div class="row">
            <div class="col">
                <p>Servings: @Model.Servings</p>
            </div>
            <div class="col">
                <p>Time: @Model.Time</p>
            </div>
        </div>
        
    </header>
    <p>@Model.LongDescription</p>
    <section class="row">
        <div class="col">
            <h3>Ingredients</h3>
            <ul>
                @foreach (var ingredient in ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>
           
        </div>
        <div class="col">
            <h3>Instructions</h3>
            <ol>
                @foreach (var instruction in instructions)
                {
                    <li>@instruction</li>
                }
            </ol>
            
        </div>
    </section>
</article>

