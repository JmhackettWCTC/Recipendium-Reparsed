@* Recipe Details - Shows full recipe information including ingredients and instructions *@
@model Recipendium_Reparsed.Models.Recipe
@{
    ViewData["Title"] = Model.Name;
    
    @* Parse ingredients - new recipes use newlines, old recipes may use pipes *@
    string ingredientsRaw = Model.Ingredients.Replace("\r\n", "\n").Replace("\r", "\n").Trim();
    string[] ingredients;
    if (ingredientsRaw.Contains("\n"))
    {
        ingredients = ingredientsRaw.Split('\n', StringSplitOptions.RemoveEmptyEntries);
    }
    else
    {
        ingredients = ingredientsRaw.Split('|', StringSplitOptions.RemoveEmptyEntries);
    }
    ingredients = ingredients.Select(i => i.Trim()).ToArray();

    @* Parse instructions - data uses pipe (|) as separator *@
    string[] instructions = Model.Instructions
        .Split('|', StringSplitOptions.RemoveEmptyEntries)
        .Select(i => i.Trim())
        .ToArray();
}

@* Recipe Header with Metadata *@
<header>
    <h2>@Model.Name</h2>
    <div class="static-row">
        <div class="flex-1">
            <p>Category: @Model.Category?.Name</p>
        </div>
        <div class="flex-1">
            <p>Servings: @Model.Servings</p>
        </div>
        <div class="flex-1">
            <p>Cooking time: @Model.Time mins</p>
        </div>
        <div class="flex-1">
            <p>Rating: @Model.Rating / 5</p>
        </div>
    </div>
</header>

@* Long Description Section *@
<section>
    <p>@Model.LongDescription</p>
</section>

@* Ingredients and Instructions Side-by-Side *@
<section class="row">
    <div class="flex-1">
        @* Ingredients List *@
        <header>
            <h3>Ingredients</h3>
        </header>
        @if (ingredients.Length > 0)
        {
            <ul>
                @foreach (var ingredient in ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>
        }
        else
        {
            <div class="empty-list">
                <p>No ingredients listed for this recipe.</p>
                <a asp-action="Edit" asp-route-id="@Model.Id">Edit this recipe to add ingredients</a>
            </div>
        }
    </div>
    <div class="flex-1">
        @* Instructions List *@
        <header>
            <h3>Instructions</h3>
        </header>
        @if (instructions.Length > 0)
        {
            <ol>
                @foreach (var instruction in instructions)
                {
                    <li>@instruction</li>
                }
            </ol>
        }
        else
        {
            <div class="empty-list">
                <p>No instructions listed for this recipe.</p>
                <a asp-action="Edit" asp-route-id="@Model.Id">Edit this recipe to add instructions</a>
            </div>
        }
    </div>
</section>

@* Sub-Recipes Section *@
@if (Model.SubRecipes != null && Model.SubRecipes.Any())
{
    <section class="sub-recipes-section">
        <header>
            <h3>Sub-Recipes</h3>
        </header>
        @foreach (var subRecipe in Model.SubRecipes.OrderBy(s => s.Order))
        {
            string subIngredientsRaw = subRecipe.Ingredients.Replace("\r\n", "\n").Replace("\r", "\n").Trim();
            string[] subIngredients;
            if (subIngredientsRaw.Contains("\n"))
            {
                subIngredients = subIngredientsRaw.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            }
            else
            {
                subIngredients = subIngredientsRaw.Split('|', StringSplitOptions.RemoveEmptyEntries);
            }
            subIngredients = subIngredients.Select(i => i.Trim()).ToArray();

            string[] subInstructions = subRecipe.Instructions
                .Split('|', StringSplitOptions.RemoveEmptyEntries)
                .Select(i => i.Trim())
                .ToArray();

            <div class="sub-recipe-card">
                <header>
                    <h4>@subRecipe.Name</h4>
                </header>
                <div class="row">
                    <div class="flex-1">
                        <h5>Ingredients</h5>
                        @if (subIngredients.Length > 0)
                        {
                            <ul>
                                @foreach (var ingredient in subIngredients)
                                {
                                    <li>@ingredient</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No ingredients listed.</p>
                        }
                    </div>
                    <div class="flex-1">
                        <h5>Instructions</h5>
                        @if (subInstructions.Length > 0)
                        {
                            <ol>
                                @foreach (var instruction in subInstructions)
                                {
                                    <li>@instruction</li>
                                }
                            </ol>
                        }
                        else
                        {
                            <p class="text-muted">No instructions listed.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </section>
}

@* Navigation Back Button *@
<a class="back-btn" asp-action="Index">← Back to Recipes</a>
