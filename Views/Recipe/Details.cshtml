@* Recipe Details - Shows full recipe information including ingredients and instructions *@
@model Recipendium_Reparsed.Models.Recipe
@{
    ViewData["Title"] = Model.Name;
    
    @* Parse ingredients - new recipes use newlines, old recipes may use pipes *@
    string ingredientsRaw = Model.Ingredients.Replace("\r\n", "\n").Replace("\r", "\n").Trim();
    string[] ingredients;
    if (ingredientsRaw.Contains("\n"))
    {
        ingredients = ingredientsRaw.Split('\n', StringSplitOptions.RemoveEmptyEntries);
    }
    else
    {
        ingredients = ingredientsRaw.Split('|', StringSplitOptions.RemoveEmptyEntries);
    }
    ingredients = ingredients.Select(i => i.Trim()).ToArray();

    @* Parse instructions - data uses pipe (|) as separator *@
    string[] instructions = Model.Instructions
        .Split('|', StringSplitOptions.RemoveEmptyEntries)
        .Select(i => i.Trim())
        .ToArray();
}

@* Recipe Header with Metadata *@
<header>
    <h2>@Model.Name</h2>
    <div class="static-row">
        <div class="flex-1">
            <p>Category: @Model.Category?.Name</p>
        </div>
        <div class="flex-1">
            <p>Servings: @Model.Servings</p>
        </div>
        <div class="flex-1">
            <p>Cooking time: @Model.Time mins</p>
        </div>
        <div class="flex-1">
            <p>Rating: @Model.Rating / 5</p>
        </div>
    </div>
</header>

@* Long Description Section *@
<section>
    <p>@Model.LongDescription</p>
</section>

@* Ingredients and Instructions Side-by-Side *@
<section class="row">
    <div class="flex-1">
        @* Ingredients List *@
        <header>
            <h3>Ingredients</h3>
        </header>
        <ul>
            @foreach (var ingredient in ingredients)
            {
                <li>@ingredient</li>
            }
        </ul>
    </div>
    <div class="flex-1">
        @* Instructions List *@
        <header>
            <h3>Instructions</h3>
        </header>
        <ol>
            @foreach (var instruction in instructions)
            {
                <li>@instruction</li>
            }
        </ol>
    </div>
</section>

@* Navigation Back Button *@
<a class="back-btn" asp-action="Index">← Back to Recipes</a>
