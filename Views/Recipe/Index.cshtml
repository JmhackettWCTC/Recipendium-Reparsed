@* Recipe Index - Displays all recipes in a card grid with filtering and sorting *@
@model List<Recipendium_Reparsed.Models.Recipe>

@{
    ViewData["Title"] = "Recipes";
    var categories = ViewData["Categories"] as List<Recipendium_Reparsed.Models.Category> ?? new List<Recipendium_Reparsed.Models.Category>();
    var currentCategory = ViewData["CurrentCategory"] as string;
    var currentSort = ViewData["CurrentSort"] as string ?? "nameAsc";
    var currentSearch = ViewData["CurrentSearch"] as string;
    
    // Serialize data for Vue component
    var recipesJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(r => new {
        id = r.Id,
        name = r.Name,
        image = r.Image,
        categoryName = r.Category?.Name,
        time = r.Time,
        servings = r.Servings,
        rating = r.Rating,
        shortDescription = r.ShortDescription
    })));
    var categoriesJson = Html.Raw(System.Text.Json.JsonSerializer.Serialize(categories.Select(c => new {
        id = c.Id,
        name = c.Name
    })));
}

<div id="app">
    <recipe-index
        :recipes-json='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(recipesJson.ToString()))'
        :categories-json='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(categoriesJson.ToString()))'
        current-category='@(currentCategory ?? "")'
        current-sort='@(currentSort ?? "nameAsc")'
        current-search='@(currentSearch ?? "")'
    ></recipe-index>
</div>

@section Scripts {
    <script type="module">
        import RecipeIndex from '/js/components/RecipeIndexComponent.js';
        import { mountApp } from '/js/main.js';
        mountApp('#app', { 'recipe-index': RecipeIndex });
    </script>
}
