@* Create Recipe Form - Allows users to add a new recipe *@
@model Recipendium_Reparsed.Models.Recipe

@{
    ViewData["Title"] = "Create Recipe";
}

@* Page Header *@
<header>
    <h1>Create Recipe</h1>
</header>

@* Recipe Creation Form *@
<form asp-action="Create">
    @* Basic Information Section *@
    <div class="form-group mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="error"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Category"></label>
        <input asp-for="Category" />
        <span asp-validation-for="Category" class="error"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Time"></label>
        <input asp-for="Time" type="number" />
        <span asp-validation-for="Time" class="error"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Servings"></label>
        <input asp-for="Servings" type="number" />
        <span asp-validation-for="Servings" class="error"></span>
    </div>

    @* Recipe Content Section *@
    <div class="form-group mb-3">
        <label asp-for="Ingredients"></label>
        <textarea asp-for="Ingredients" rows="3"></textarea>
        <span asp-validation-for="Ingredients" class="error"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Instructions"></label>
        <textarea asp-for="Instructions" rows="3"></textarea>
        <span asp-validation-for="Instructions" class="error"></span>
    </div>

    @* Description Section *@
    <div class="form-group mb-3">
        <label asp-for="ShortDescription"></label>
        <input asp-for="ShortDescription" />
        <span asp-validation-for="ShortDescription" class="error"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="LongDescription"></label>
        <textarea asp-for="LongDescription" rows="3"></textarea>
        <span asp-validation-for="LongDescription" class="error"></span>
    </div>

    @* Rating Section *@
    <div class="form-group mb-3">
        <label asp-for="Rating"></label>
        <input asp-for="Rating" type="number" min="0" max="5" step="0.1" />
        <span asp-validation-for="Rating" class="error"></span>
    </div>

    @* Submit Button *@
    <div class="form-group">
        <button type="submit">Create</button>
    </div>
</form>

@* Navigation Back Button *@
<a class="back-btn" asp-action="Index">← Back to Recipes</a>
