@* User Login Form *@
@using System.Linq
@model Recipendium_Reparsed.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

<form asp-action="Login" method="post">
    @{
        var errors = ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
    }
    @if (errors.Any())
    {
        <div class="alert alert-danger">
            <ul class="validation-summary-errors">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" placeholder="Email address" />
        <span asp-validation-for="Email" class="error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="error"></span>
    </div>

    <button type="submit" class="btn btn-primary">Log in</button>
</form>

<p>
    <a asp-action="Register">Don't have an account? Register</a>
</p>
